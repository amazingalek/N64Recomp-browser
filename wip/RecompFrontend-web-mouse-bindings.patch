+        DEFINE_INPUT(EXTRA_4, 0, "Extra 4") \
+        DEFINE_INPUT(EXTRA_5, 0, "Extra 5") \
+        DEFINE_INPUT(EXTRA_6, 0, "Extra 6") \
+        DEFINE_INPUT(EXTRA_7, 0, "Extra 7") \
+        DEFINE_INPUT(EXTRA_8, 0, "Extra 8")
+
     #define DEFINE_RECOMP_UI_INPUTS() \
         DEFINE_INPUT(TOGGLE_MENU, 0, "Toggle Menu") \
         DEFINE_INPUT(ACCEPT_MENU, 0, "Accept (Menu)") \
@@ -40,6 +54,7 @@ namespace recompinput {
     #define DEFINE_ALL_INPUTS() \
         DEFINE_N64_AXIS_INPUTS() \
         DEFINE_N64_BUTTON_INPUTS() \
+        DEFINE_EXTRA_INPUTS() \
         DEFINE_RECOMP_UI_INPUTS()
 
     #define DEFINE_INPUT(name, value, readable) name,
@@ -54,6 +69,8 @@ namespace recompinput {
         N64_BUTTON_COUNT = C_RIGHT - N64_BUTTON_START + 1,
         N64_AXIS_START = X_AXIS_NEG,
