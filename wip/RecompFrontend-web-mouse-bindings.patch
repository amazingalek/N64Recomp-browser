     #undef DEFINE_INPUT
 
@@ -67,6 +84,10 @@ namespace recompinput {
     };
 
     
+    // A Mouse input's input_id: SDL's button number (SDL_BUTTON_LEFT and on), or a notch of the wheel.
+    constexpr int32_t mouse_wheel_up = 0x100;
+    constexpr int32_t mouse_wheel_down = 0x101;
+
     // A single input. Combines the source of the input (see InputType) and a specific key/button/axis.
     struct InputField {
         InputType input_type;
@@ -79,6 +100,14 @@ namespace recompinput {
             return InputField{ InputType::Keyboard, static_cast<int32_t>(key) };
         }
 
+        static InputField mouse_button(int button) {
+            return InputField{ InputType::Mouse, button };
+        }
+
+        static InputField mouse_wheel(bool up) {
+            return InputField{ InputType::Mouse, up ? mouse_wheel_up : mouse_wheel_down };
+        }
+
         static InputField controller_digital(SDL_GameControllerButton button) {
             return InputField{ InputType::ControllerDigital, static_cast<int32_t>(button) };
         }
