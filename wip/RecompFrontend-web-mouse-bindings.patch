 const std::string& get_game_input_name(GameInput input) {
     return game_input_names.at(static_cast<size_t>(input));
@@ -227,6 +232,19 @@ static std::string keyboard_input_to_string(SDL_Scancode key) {
     return recompinput::unknown_device_input;
 }
 
+static std::string mouse_input_to_string(int32_t input_id) {
+    switch (input_id) {
+    case SDL_BUTTON_LEFT: return PF_MOUSE_1;
+    case SDL_BUTTON_RIGHT: return PF_MOUSE_2;
+    case SDL_BUTTON_MIDDLE: return PF_MOUSE_3;
+    case SDL_BUTTON_X1: return PF_MOUSE_4;
+    case SDL_BUTTON_X2: return PF_MOUSE_5;
+    case recompinput::mouse_wheel_up: return PF_MOUSE_SCROLL_UP;
+    case recompinput::mouse_wheel_down: return PF_MOUSE_SCROLL_DOWN;
+    default: return recompinput::unknown_device_input;
+    }
+}
+
 static std::string controller_axis_to_string(int axis) {
     bool positive = axis > 0;
     SDL_GameControllerAxis actual_axis = SDL_GameControllerAxis(abs(axis) - 1);
@@ -260,6 +278,8 @@ std::string recompinput::InputField::to_string() const {
         return controller_axis_to_string(input_id);
     case InputType::Keyboard:
         return keyboard_input_to_string((SDL_Scancode)input_id);
+    case InputType::Mouse:
+        return mouse_input_to_string(input_id);
     default:
         return recompinput::unknown_device_input;
     }
diff --git a/recompinput/src/profiles.cpp b/recompinput/src/profiles.cpp
index c89956e..51f520f 100644
--- a/recompinput/src/profiles.cpp
+++ b/recompinput/src/profiles.cpp
@@ -414,6 +414,29 @@ namespace recompinput {
         return true;
     }
 
+    uint32_t profiles::get_extra_inputs(int player_index) {
+        uint32_t held = 0;
+        if (recompinput::game_input_disabled()) {
+            return held;
+        }
+        auto check_extras = [&](int profile_index) {
+            if (profile_index < 0) {
+                return;
+            }
+            const input_mapping_array &mappings = input_profiles[profile_index].mappings;
+            for (size_t i = 0; i < (size_t)GameInput::EXTRA_COUNT; i++) {
+                GameInput input = static_cast<GameInput>((size_t)GameInput::EXTRA_START + i);
+                if (!recompinput::get_game_input_disabled(input) && recompinput::get_input_digital(player_index, mappings[(size_t)input])) {
+                    held |= 1u << i;
+                }
+            }
+        };
+        bool single_player = players::is_single_player_mode();
+        check_extras(single_player ? profiles::get_sp_controller_profile_index() : players_input_profile_indices[player_index].first);
+        check_extras(single_player ? profiles::get_sp_keyboard_profile_index() : players_input_profile_indices[player_index].second);
+        return held;
+    }
+
     static void add_input_bindings(json& out, int profile_index, GameInput input) {
         const std::string& input_name = recompinput::get_game_input_enum_name(input);
         json& out_array = out[input_name];
