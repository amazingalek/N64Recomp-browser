diff --git a/recompinput/src/input_events.cpp b/recompinput/src/input_events.cpp
index c76a1dc..a828e48 100644
--- a/recompinput/src/input_events.cpp
+++ b/recompinput/src/input_events.cpp
@@ -117,10 +117,30 @@ bool sdl_event_filter(void* userdata, SDL_Event* event) {
     case SDL_EventType::SDL_MOUSEWHEEL:
     {
         SDL_MouseWheelEvent* wheel_event = &event->wheel;
-        recompinput::add_mouse_wheel_delta(wheel_event->y * (wheel_event->direction == SDL_MOUSEWHEEL_FLIPPED ? -1 : 1));
+        int32_t delta = wheel_event->y * (wheel_event->direction == SDL_MOUSEWHEEL_FLIPPED ? -1 : 1);
+        if (binding::is_binding()) {
+            if (delta != 0 && binding::get_scanning_device() == InputDevice::Keyboard) {
+                binding::set_scanned_input(InputField::mouse_wheel(delta > 0));
+            }
+            break;
+        }
+        // Scrolling a menu turns no notches for the game.
+        if (delta != 0 && !recompinput::game_input_disabled()) {
+            recompinput::add_mouse_wheel_delta(delta);
+        }
     }
     queue_if_enabled(event);
     break;
+    case SDL_EventType::SDL_MOUSEBUTTONDOWN:
+        // Mouse buttons bind beside the keyboard's keys.
+        if (binding::is_binding()) {
+            if (binding::get_scanning_device() == InputDevice::Keyboard) {
+                binding::set_scanned_input(InputField::mouse_button(event->button.button));
+            }
+            break;
+        }
+        queue_if_enabled(event);
+        break;
     case SDL_EventType::SDL_CONTROLLERBUTTONDOWN:
         if (binding::is_binding() && binding::is_controller_being_bound(event->cbutton.which)) {
             // TODO: Needs the controller profile index.
diff --git a/recompinput/src/input_state.cpp b/recompinput/src/input_state.cpp
index ebbc5c7..6e52a25 100644
--- a/recompinput/src/input_state.cpp
+++ b/recompinput/src/input_state.cpp
@@ -2,6 +2,7 @@
 #include <mutex>
 #include <span>
 #include <atomic>
+#include <chrono>
 
 #include "recompinput/recompinput.h"
 #include "recompinput/input_state.h"
@@ -18,7 +19,13 @@ static struct {
     const Uint8* keys = nullptr;
     SDL_Keymod keymod = SDL_Keymod::KMOD_NONE;
     int numkeys = 0;
-    std::atomic_int32_t mouse_wheel_pos = 0;
+    Uint32 mouse_buttons = 0;
+    std::mutex wheel_mutex;
+    // A wheel binding reads as held for each notch, wheel_press long, with wheel_release between two notches, so a
+    // game that reads its controller once a frame sees every one as a press of its own: {up, down}.
+    std::array<int, 2> wheel_pending{};
+    std::array<bool, 2> wheel_held{};
+    std::array<std::chrono::steady_clock::time_point, 2> wheel_changed{};
     std::mutex controllers_mutex;
     std::vector<SDL_GameController*> detected_controllers{};
     std::unordered_map<SDL_JoystickID, ControllerState> controller_states;
@@ -34,6 +41,7 @@ static struct {
 void recompinput::poll_inputs() {
     InputState.keys = SDL_GetKeyboardState(&InputState.numkeys);
     InputState.keymod = SDL_GetModState();
+    InputState.mouse_buttons = SDL_GetMouseState(nullptr, nullptr);
     static bool first_poll = true;
 
     {
@@ -269,6 +277,37 @@ float controller_axis_state(int controller_num, int32_t input_id, bool allow_sup
     return false;
 }
 
+static bool mouse_wheel_state(int direction) {
+    constexpr auto wheel_press = std::chrono::milliseconds(60);
+    constexpr auto wheel_release = std::chrono::milliseconds(60);
+    std::lock_guard lock{ InputState.wheel_mutex };
+    auto now = std::chrono::steady_clock::now();
+    auto since = now - InputState.wheel_changed[direction];
+    if (InputState.wheel_held[direction]) {
+        if (since >= wheel_press) {
+            InputState.wheel_held[direction] = false;
+            InputState.wheel_changed[direction] = now;
+        }
+    }
+    else if (InputState.wheel_pending[direction] > 0 && since >= wheel_release) {
+        InputState.wheel_pending[direction]--;
+        InputState.wheel_held[direction] = true;
+        InputState.wheel_changed[direction] = now;
+    }
+    return InputState.wheel_held[direction];
+}
+
+static bool mouse_input_state(int32_t input_id) {
+    switch (input_id) {
+    case recompinput::mouse_wheel_up:
+        return mouse_wheel_state(0);
+    case recompinput::mouse_wheel_down:
+        return mouse_wheel_state(1);
+    default:
+        return input_id > 0 && input_id <= 32 && (InputState.mouse_buttons & SDL_BUTTON(input_id)) != 0;
+    }
+}
+
 bool recompinput::should_override_keystate(SDL_Scancode key, SDL_Keymod mod) {
     // Override Enter when Alt is held.
     if (key == SDL_Scancode::SDL_SCANCODE_RETURN) {
@@ -295,8 +334,7 @@ float recompinput::get_input_analog(int controller_num, const InputField& field)
     case InputType::ControllerAnalog:
         return controller_axis_state(controller_num, field.input_id, true);
     case InputType::Mouse:
-        // TODO mouse support
-        return 0.0f;
+        return mouse_input_state(field.input_id) ? 1.0f : 0.0f;
     case InputType::None:
         return false;
     }
@@ -326,8 +364,7 @@ bool recompinput::get_input_digital(int controller_num, const InputField& field)
         // TODO adjustable threshold
         return controller_axis_state(controller_num, field.input_id, true) >= recompinput::axis_digital_threshold;
     case InputType::Mouse:
-        // TODO mouse support
-        return false;
+        return mouse_input_state(field.input_id);
     case InputType::None:
         return false;
     }
@@ -477,5 +514,9 @@ void recompinput::add_mouse_deltas(float delta_x, float delta_y) {
     InputState.pending_mouse_delta[1] += delta_y;
 }
 void recompinput::add_mouse_wheel_delta(int32_t delta) {
-    InputState.mouse_wheel_pos.fetch_add(delta);
+    // At most a few notches wait, so a fast spin doesn't keep a wheel binding pressing for seconds after.
+    constexpr int max_pending = 3;
+    std::lock_guard lock{ InputState.wheel_mutex };
+    int &pending = InputState.wheel_pending[delta > 0 ? 0 : 1];
+    pending = std::min(pending + std::abs(delta), max_pending);
 }
